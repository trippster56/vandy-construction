# Neon Postgres (database)
# Get a connection string from https://console.neon.tech
# Optional — the app falls back to static data without it
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Resend (contact form)
# Get an API key from https://resend.com
# Optional — contact form logs to console without it
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=contact@yourdomain.com
RESEND_TO_EMAIL=hello@yourdomain.com
# Optional — where subcontractor submissions go. Falls back to RESEND_TO_EMAIL,
# so set this to keep trade-partner forms out of Josh's main inbox.
RESEND_SUBS_TO_EMAIL=

# Google Analytics 4
# Measurement ID from your GA4 property (Admin → Data Streams)
# Optional — GA snippet only loads when set
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Stripe (payments)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Neon Auth (admin login)
# Auth URL from Neon Console → Better Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth
# Signs the session cookie — generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Comma-separated emails allowed into /admin (sign-in alone is not enough)
ADMIN_EMAILS=
